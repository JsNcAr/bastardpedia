# Bastardpedia on a server running Caddy. Layout:
#
#   /opt/bastardpedia/dist     the web app, `npm run build` output (deployed by CI)
#   /opt/bastardpedia/deploy   this file
#
# Import it from the main Caddyfile:   import /opt/bastardpedia/deploy/Caddyfile
# TLS is automatic once bastardpedia.ramsus.site resolves to this host. docs/DEPLOYMENT.md.

bastardpedia.ramsus.site {
	encode zstd gzip

	# Private until the public launch: set "private": false in project.config.json,
	# regenerate, and reload Caddy. Credentials live in the server's environment.
	basic_auth {
		{$BASTARDPEDIA_AUTH_USER} {$BASTARDPEDIA_AUTH_HASH}
	}

	root * /opt/bastardpedia/dist

	# Vite fingerprints everything under assets/: cache it forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The HTML, the service worker and the catalog decide what a visitor sees.
	# Cached, a release would never reach anyone who has opened the site once.
	@revalidate path / /index.html /sw.js /registerSW.js /workbox-*.js /manifest.webmanifest /data/*
	header @revalidate Cache-Control "no-cache"

	# History routing: any path that is not a file is an app route (docs/adr/0002).
	try_files {path} /index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Everything is self-hosted. No inline scripts or styles anywhere (eslint enforces it).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	log {
		output file /var/log/caddy/bastardpedia.access.log
		format console
	}
}
